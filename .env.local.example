# Get a free API key from https://console.groq.com/keys
GROQ_API_KEY=your_api_key_here

# From your Supabase project's Settings > API page
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Settings > API > service_role — SECRET, server-only, never expose to the
# browser (no NEXT_PUBLIC_ prefix). Used to bypass RLS for billing writes
# (Stripe webhook, credit grants, API key verification).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Stripe (hybrid pricing) ---
# From https://dashboard.stripe.com/apikeys — use a test-mode secret key
# (sk_test_...) until you're ready to charge real cards.
STRIPE_SECRET_KEY=your_stripe_secret_key

# From https://dashboard.stripe.com/webhooks — create an endpoint pointing
# at <your-site>/api/stripe/webhook, subscribed to at least:
# checkout.session.completed, invoice.paid, customer.subscription.deleted.
# For local dev, use the Stripe CLI instead: `stripe listen --forward-to
# localhost:3000/api/stripe/webhook` prints a webhook secret to use here.
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Create a recurring monthly Price in the Stripe Dashboard (Products > Add
# product) for each paid plan in lib/pricing.ts, then paste its Price ID
# (price_...) here. Amounts must match lib/pricing.ts's monthlyPriceUsd —
# Stripe is the source of truth for what actually gets charged.
STRIPE_PRICE_PROSUMER=price_your_prosumer_price_id
STRIPE_PRICE_TEAM=price_your_team_price_id

# Used to build Stripe success/cancel URLs. Defaults to the request's own
# origin if unset, but set this explicitly in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
