# Get a free API key from https://console.groq.com/keys
# Used directly only when PORTKEY_API_KEY (below) isn't set.
GROQ_API_KEY=your_api_key_here

# Optional but recommended — routes generation through Portkey's gateway
# instead of calling Groq directly, for retries/fallback/caching config,
# cost tracking, and observability. Get a key at https://app.portkey.ai,
# then add Groq as a provider in Settings > Model Catalog and note the
# slug you gave it (defaults to "groq" below if you used that name).
# If unset, the app falls back to calling Groq directly with GROQ_API_KEY.
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_GROQ_SLUG=groq

# Optional but recommended — durable, cross-instance rate limiting for
# report generation, enforced in Edge Middleware before a request ever
# reaches Groq/Portkey. Get a free Redis database at https://console.upstash.com
# (REST API, not a connection string) and copy its REST URL + token.
# If unset, the app falls back to an in-memory per-IP limiter that resets
# on every server restart/cold start — fine for local dev, not for
# production traffic.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# From your Supabase project's Settings > API page
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
